// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id           String          @id @default(cuid())
  name         String
  memberships  Membership[]
  prompts      PromptVersion[]
  seeds        Seed[]
  drafts       Draft[]
  histories    History[]
  draftAudits  DraftAudit[]
  approvalJobs ApprovalJob[]
  metrics      Metric[]
  schedules    Schedule[]
  integrations Integration[]
  suggestions  Suggestion[]
  comments     Comment[]
  activities   Activity[]
  createdAt    DateTime        @default(now())
}

model Membership {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String
  email     String
  role      String
  createdAt DateTime @default(now())

  @@index([orgId, email], name: "membership_org_email")
}

model Integration {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String
  provider  String
  data      Json
  createdAt DateTime @default(now())

  @@index([orgId, provider], name: "integration_org_provider")
  @@unique([orgId, provider], map: "integration_org_provider_unique")
}

model PromptVersion {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String
  content   String
  author    String
  notes     String?
  createdAt DateTime @default(now())
}

model Seed {
  id        String    @id @default(cuid())
  org       Org       @relation(fields: [orgId], references: [id])
  orgId     String
  title     String
  notes     String?
  tags      String[]
  state     String
  drafts    Draft[]
  histories History[]
  createdAt DateTime  @default(now())
}

model Draft {
  id              String       @id @default(cuid())
  org             Org          @relation(fields: [orgId], references: [id])
  orgId           String
  seed            Seed         @relation(fields: [seedId], references: [id])
  seedId          String
  platform        String
  originalText    String
  editedText      String?
  promptVersionId String?
  generatorRunId  String?
  generatedAt     DateTime?
  histories       History[]
  audits          DraftAudit[]
  approvalJobs    ApprovalJob[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model DraftAudit {
  id         String   @id @default(cuid())
  org        Org      @relation(fields: [orgId], references: [id])
  orgId      String
  draft      Draft    @relation(fields: [draftId], references: [id])
  draftId    String
  editor     String
  editedText String
  createdAt  DateTime @default(now())

  @@index([orgId, draftId], name: "draft_audit_org_draft")
}

model ApprovalJob {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String
  draft     Draft    @relation(fields: [draftId], references: [id])
  draftId   String
  jobId     String
  runAt     DateTime
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, draftId], map: "approval_job_org_draft_unique")
  @@index([orgId, draftId], name: "approval_job_org_draft")
}

model History {
  id           String   @id @default(cuid())
  org          Org      @relation(fields: [orgId], references: [id])
  orgId        String
  seed         Seed     @relation(fields: [seedId], references: [id])
  seedId       String
  draft        Draft    @relation(fields: [draftId], references: [id])
  draftId      String
  platform     String
  postId       String
  url          String?
  originalText String
  editedText   String?
  publishedAt  DateTime @default(now())
  status       String   @default("success")
  error        String?
}

model Metric {
  id          String   @id @default(cuid())
  org         Org      @relation(fields: [orgId], references: [id])
  orgId       String
  postId      String
  platform    String
  likes       Int
  comments    Int
  shares      Int
  impressions Int?
  at          DateTime
}

model Schedule {
  id       String   @id @default(cuid())
  org      Org      @relation(fields: [orgId], references: [id])
  orgId    String
  platform String
  postId   String
  runAt    DateTime
}

model Suggestion {
  id         String     @id @default(cuid())
  org        Org        @relation(fields: [orgId], references: [id])
  orgId      String
  content    String
  createdBy  String
  status     String
  createdAt  DateTime   @default(now())
  comments   Comment[]
  activities Activity[]
}

model Comment {
  id           String     @id @default(cuid())
  org          Org        @relation(fields: [orgId], references: [id])
  orgId        String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id])
  suggestionId String
  text         String
  author       String
  createdAt    DateTime   @default(now())
}

model Activity {
  id           String      @id @default(cuid())
  org          Org         @relation(fields: [orgId], references: [id])
  orgId        String
  type         String
  refId        String?
  actor        String
  at           DateTime    @default(now())
  suggestion   Suggestion? @relation(fields: [suggestionId], references: [id])
  suggestionId String?
}
